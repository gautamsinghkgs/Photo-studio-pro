<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      ⭐ PRIVACY: this is the ONLY network permission in the entire app, and app
      code never uses it. It exists solely because the AdMob, Firebase and
      RevenueCat SDKs require it. NO photo ever leaves the device.
      We deliberately do NOT declare:
        READ_EXTERNAL_STORAGE / READ_MEDIA_IMAGES  (we use the Storage Access
                                                    Framework instead)
        CAMERA                                     (we pick from the gallery)
        ACCESS_FINE_LOCATION / CONTACTS / anything else
      SPEC.md section 11.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".PhotoStudioApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PhotoStudioPro"
        android:largeHeap="true"
        tools:targetApi="36">

        <!--
          ⭐ ML KIT MODEL AUTO-DOWNLOAD  (SPEC.md section 6, M1)
          Subject Segmentation is UNBUNDLED ONLY — there is no bundled artifact.
          This declaration makes Google Play Services download the model in the
          background immediately after install from the Play Store, so by the
          time the user opens the app and picks a photo it is usually already
          present. Without this the model would download on first use and
          "requests made before the download has completed produce no results"
          (Google's own docs).
          Face Detection and Text Recognition are BUNDLED so they need no entry.
        -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="subject_segment" />

        <!--
          ⭐ ADMOB APPLICATION ID
          The value below is GOOGLE'S OFFICIAL SAMPLE APP ID. It works for
          development but shows no real revenue. Replace it with your own from
          AdMob → Apps → App settings → App ID (YOUR-TURN.md step 7).
          Forgetting this is the single most common AdMob setup mistake.
        -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />

        <!-- Delay ad personalization / measurement initialisation until we have
             UMP consent. Required for EEA/UK fill. -->
        <meta-data
            android:name="com.google.android.gms.ads.DELAY_APP_MEASUREMENT_INIT"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.PhotoStudioPro">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- FileProvider: lets us share an exported image/PDF with other apps
             without granting broad storage permissions. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
